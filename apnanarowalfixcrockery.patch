From f9ea135c826be5be7e1efe93e8d6715c5fab14f4 Mon Sep 17 00:00:00 2001
From: hamid <rebornwear.hamid@gmail.com>
Date: Thu, 3 Sep 2026 14:10:39 +0000
Subject: [PATCH] Fix category tiles and Crockery listing not showing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two symptoms, one cause: the Madina Crockery entry (id:36) was placed
outside the BUSINESSES array closing bracket. That top-level object
literal is a JavaScript syntax error, which aborted parsing of the
entire inline script and left showListings() and every other function
undefined — so category tiles did nothing on click, and the Crockery
listing never made it into the dataset.

Move id:36 inside the array before the closing ];. Also compute the
homepage category tile counts from BUSINESSES on DOMContentLoaded, so
future listing additions update the tile counts automatically and no
hand-maintained count can drift out of sync.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GRgGkMutV5bVQNPxsgXHHL
---
 index.html | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/index.html b/index.html
index e9977ef..94a37db 100644
--- a/index.html
+++ b/index.html
@@ -1209,8 +1209,8 @@ const BUSINESSES = [
   {id:33, name:'TMA Narowal (Municipal)', cat:'Govt', area:'Narowal', phone:'0542-412300', addr:'TMA Office, Narowal City', desc:'Tehsil Municipal Administration — local development, sanitation, building permits, and municipal services.', icon:'🏛️', verified:true, featured:false, lat:32.1010, lng:74.8745, rating:3.4, reviews:28, hours:{open:'09:00',close:'17:00',allDay:false}, tags:['permits','sanitation','municipal','govt']},
   {id:34, name:'Tehsil Office Shakargarh', cat:'Govt', area:'Shakargarh', phone:'0544-500100', addr:'Tehsil HQ, Shakargarh', desc:'Tehsil headquarters for Shakargarh — local government services, revenue records, and municipal administration.', icon:'🏛️', verified:true, featured:false, lat:32.2660, lng:75.1590, rating:3.5, reviews:31, hours:{open:'09:00',close:'17:00',allDay:false}, tags:['revenue','admin','govt']},
   {id:35, name:'Tehsil Office Zafarwal', cat:'Govt', area:'Zafarwal', phone:'0542-590100', addr:'Tehsil Road, Zafarwal', desc:'Zafarwal tehsil office — local government services, revenue records, domicile, and administrative functions.', icon:'🏛️', verified:true, featured:false, lat:32.3448, lng:74.9005, rating:3.4, reviews:24, hours:{open:'09:00',close:'17:00',allDay:false}, tags:['domicile','admin','govt']},
+  {id:36, name:'Madina Crockery', cat:'Crockery', area:'Shakargarh', phone:'0300-7779272', addr:'Near Noor Masjid, Main Bazar, Shakargarh', desc:'Fine quality kitchenware and crockery range.', icon:'🍽️', verified:true, featured:false, lat:32.2670, lng:75.1598, rating:5.0, reviews:1, hours:{open:'09:00',close:'20:00',allDay:false}, tags:['crockery','kitchenware','shakargarh']},
 ];
-{id:36, name:'Madina Crockery', cat:'Crockery', area:'Shakargarh', phone:'0300-7779272', addr:'Near Noor Masjid, Main Bazar, Shakargarh', desc:'Fine quality kitchenware and crockery range.', icon:'🍽️', verified:true, featured:false, lat:32.2670, lng:75.1598, rating:5.0, reviews:1, hours:{open:'09:00',close:'20:00',allDay:false}, tags:['crockery','kitchenware','shakargarh']}
 /* ═══ REVIEWS STORE ═════════════════════════════════════════════ */
 let reviewsDB = JSON.parse(localStorage.getItem('an_reviews') || '{}');
 let favs = JSON.parse(localStorage.getItem('an_favs') || '[]');
@@ -1934,6 +1934,16 @@ window.addEventListener('DOMContentLoaded', () => {
   currentCatFilter = 'Hospital';
   renderListings();
   updateMeta('home');
+  // Auto-compute homepage category tile counts from BUSINESSES so counts
+  // never drift when listings are added or removed.
+  document.querySelectorAll('.cat-card').forEach(card => {
+    const m = /showListings\(['"]([^'"]+)['"]\)/.exec(card.getAttribute('onclick') || '');
+    if (!m) return;
+    const cat = m[1];
+    const n = BUSINESSES.filter(b => b.cat === cat).length;
+    const el = card.querySelector('.cat-count');
+    if (el) el.textContent = n === 1 ? '1 listing' : `${n} listings`;
+  });
 });
 </script>
 
